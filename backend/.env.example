# Copie para .env e ajuste. Nunca versione o .env real.
PORT=3000
NODE_ENV=development

# Obrigatório em produção. Use um valor longo e aleatório.
JWT_SECRET=troque-isto
JWT_EXPIRA_EM=1h

# Origens permitidas (separadas por vírgula). Nunca use *
CORS_ORIGINS=http://localhost:5173

# Chamadas a APIs externas (ViaCEP, geocodificação)
EXTERNO_TIMEOUT_MS=4000
EXTERNO_BREAKER_FALHAS=5
EXTERNO_BREAKER_RESET_MS=15000

# Limite de tentativas de login por minuto, por IP
LOGIN_RATE_MAX=10

# Cadastros de usuário por minuto, por IP
CADASTRO_RATE_MAX=5

# Solicitações de socorro por minuto, por usuário logado (evita uso indevido)
OCORRENCIA_RATE_MAX=5

# Cria uma ocorrência de demonstração ao subir o servidor
SEED_DEMO=true
